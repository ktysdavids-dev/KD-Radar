# === KD RADAR — Configuración ===

# Google Cloud Console -> habilitar "Places API (New)" -> crear API Key
GOOGLE_PLACES_API_KEY=

# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# URL pública del servidor (Railway) para los enlaces de baja
# Ejemplo: https://kd-radar-production.up.railway.app
BASE_URL=http://localhost:8000

# Identidad del remitente (obligatorio LSSI: identificarse claramente)
REMITENTE_NOMBRE=David Amundarain — Ktys & Davids
REMITENTE_EMAIL=hola@ktysdavids.com
EMPRESA_LEGAL=Ktys & Davids Productions S.L. (CIF B16377574)

# Límite de envíos diarios (warmup: empieza en 25-40, sube semanalmente)
LOTE_DIARIO=30

# Ruta de la base de datos SQLite
DB_PATH=kd_radar.db
