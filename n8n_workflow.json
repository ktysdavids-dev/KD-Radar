{
  "name": "KD Radar — Envío diario",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "30 9 * * 1-5" }
          ]
        }
      },
      "name": "Lunes a viernes 9:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "https://TU-DOMINIO-RAILWAY.up.railway.app/api/lote",
        "options": {}
      },
      "name": "Obtener lote del día",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": { "batchSize": 1, "options": {} },
      "name": "Uno a uno",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [440, 0]
    },
    {
      "parameters": {
        "amount": "={{ 60 + Math.floor(Math.random() * 120) }}",
        "unit": "seconds"
      },
      "name": "Espera aleatoria 1-3 min",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [660, 100]
    },
    {
      "parameters": {
        "fromEmail": "David Amundarain — Ktys & Davids <hola@ktysdavids.com>",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ $json.email_asunto }}",
        "emailFormat": "text",
        "text": "={{ $json.email_cuerpo }}",
        "options": { "replyTo": "hola@ktysdavids.com" }
      },
      "name": "Enviar email (SMTP)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [880, 100],
      "credentials": {
        "smtp": { "id": "CONFIGURAR", "name": "SMTP Ktys & Davids" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://TU-DOMINIO-RAILWAY.up.railway.app/api/enviado/{{ $('Uno a uno').item.json.id }}",
        "options": {}
      },
      "name": "Marcar enviado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 100]
    }
  ],
  "connections": {
    "Lunes a viernes 9:30": {
      "main": [[{ "node": "Obtener lote del día", "type": "main", "index": 0 }]]
    },
    "Obtener lote del día": {
      "main": [[{ "node": "Uno a uno", "type": "main", "index": 0 }]]
    },
    "Uno a uno": {
      "main": [
        [],
        [{ "node": "Espera aleatoria 1-3 min", "type": "main", "index": 0 }]
      ]
    },
    "Espera aleatoria 1-3 min": {
      "main": [[{ "node": "Enviar email (SMTP)", "type": "main", "index": 0 }]]
    },
    "Enviar email (SMTP)": {
      "main": [[{ "node": "Marcar enviado", "type": "main", "index": 0 }]]
    },
    "Marcar enviado": {
      "main": [[{ "node": "Uno a uno", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
