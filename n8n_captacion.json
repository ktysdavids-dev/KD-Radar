{
  "name": "KD Radar — Captación diaria (rotación de nichos)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 7 * * 1-5" }
          ]
        }
      },
      "name": "Lunes a viernes 7:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://TU-DOMINIO-RAILWAY.up.railway.app/api/prospectar?municipios=5",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "TU_RADAR_API_KEY" }
          ]
        },
        "options": {}
      },
      "name": "Lanzar prospección",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    }
  ],
  "connections": {
    "Lunes a viernes 7:00": {
      "main": [[{ "node": "Lanzar prospección", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
